{
  "manifest_version": 3,
  "name": "ChatGPT Split View (試作)",
  "short_name": "Split View",
  "description": "ChatGPTの左サイドバーを残して、複数の会話を横一列に表示するローカルUI試作版です。",
  "version": "0.7.1",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "core.js",
        "content-layout.js",
        "workspace.js"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatGPT Split View"
  }
}
